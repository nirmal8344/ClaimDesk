# ==============================================================================
# ClaimDesk Environment Configuration Template
# Copy this file to .env and provide your deployment-specific values.
# NEVER commit the actual .env file or real secrets to source control.
# ==============================================================================

# --- Database Configuration (PostgreSQL) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# --- Backend Application Configuration (Spring Boot) ---
BACKEND_PORT=
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- Security & JWT Token Configuration ---
# Generate a cryptographically secure 256-bit (32+ bytes) secret key for JWT signing
JWT_SECRET=
JWT_EXPIRATION=

# --- CORS Configuration ---
# Comma-separated list of allowed frontend origins (e.g., https://yourdomain.com)
CORS_ALLOWED_ORIGINS=

# --- Document Storage ---
# Path to directory where claim documents and evidence photos are stored
FILE_UPLOAD_DIR=

# --- Frontend Application Configuration (Vite / React) ---
FRONTEND_PORT=
VITE_API_BASE_URL=
